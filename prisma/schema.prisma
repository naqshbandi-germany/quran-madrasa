generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// Wie eine Kurssitzung wahrgenommen wird. JITSI ist der Standard (Link wird
// automatisch generiert); ZOOM bleibt als manuelle Override-Option bestehen.
// IN_APP ist als Erweiterungspunkt für einen späteren eigenen Klassenraum
// (Video + Tafel, z.B. selbst gehostetes Jitsi) vorgesehen, ohne dass sich das
// Datenmodell ändern muss.
enum ClassroomType {
  JITSI
  ZOOM
  IN_APP
}

// Zielgruppe eines Kurses nach Alter. Ein Kurs kann mehrere Altersgruppen ansprechen
// (z.B. "für alle Altersgruppen"), daher als Array am Kurs statt als Einzelwert.
enum AgeGroup {
  KIDS // 6-13 Jahre
  TEENS // 14-22 Jahre
  ADULTS // 23+ Jahre
}

// Beziehung des Teilnehmers zum Konto-Inhaber: er selbst, sein Kind (unter 18, Erziehungs-
// berechtigung wird bestaetigt) oder eine andere erwachsene Person.
enum ParticipantRelation {
  SELF
  CHILD
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  // Optionaler muslimischer Name (z. B. bei Konvertiten zusaetzlich zum Namen im Ausweis).
  // Wird fuer die Anrede in Mails verwendet und bei Lehrkraeften neben dem Namen angezeigt.
  muslimName            String?
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(STUDENT)
  // Foto fürs Lehrer-Profil: entweder ein hochgeladenes Foto (TeacherPhoto, dann steht hier
  // /api/lehrer/<id>/foto?v=...) oder ein Link auf ein gehostetes Bild (z. B. Google-Profilbild).
  image                 String?
  // Kurze Vita fürs Lehrer-Profil, nur für Rolle TEACHER relevant.
  bio                   String?
  // E-Mail-Adresse des Zoom-Kontos, unter dem dieser Lehrer Meetings leitet (nur
  // relevant bei CLASSROOM_PROVIDER=zoom; sonst gilt ZOOM_HOST_EMAIL).
  zoomEmail             String?
  // Zeitzone der Lehrkraft (IANA-Name, z. B. "Europe/Istanbul"); leer = deutsche Zeit. Im
  // Lehrer-Bereich werden Zeiten in dieser Zone angezeigt und eingegeben (src/lib/time-zones.ts).
  timeZone              String?
  // Zeitpunkte der Bestaetigungen bei der Registrierung (Nachweis fuer die Datenschutz-
  // Kenntnisnahme und die Bestaetigung "mindestens 18 Jahre alt").
  privacyAcknowledgedAt DateTime?
  adultConfirmedAt      DateTime?
  createdAt             DateTime  @default(now())

  stripeCustomerId String? @unique
  // Geheimer Schluessel fuer das Kalender-Abo (/api/kalender/<token>), wird beim ersten Aufruf
  // des Dashboards erzeugt.
  calendarToken    String? @unique

  taughtCourses       Course[]                 @relation("TeacherCourses")
  enrollments         Enrollment[]
  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     Invitation[]             @relation("InvitationsSent")
  participants        Participant[]
  mediaFiles          MediaFile[]
  teacherPhoto        TeacherPhoto?
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  trialLessons        TrialLesson[]
}

// Hochgeladenes Foto fürs Lehrer-Profil, beim Hochladen auf 512 x 512 Pixel verkleinert (ca.
// 30 KB, daher direkt in der Datenbank). Öffentlich abrufbar über /api/lehrer/<id>/foto.
model TeacherPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt
}

model Course {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  description      String
  // Kategorie, z.B. "Quran-Rezitation (Tadschwid)", "Hifz", "Arabisch", "Islamische Wissenschaften"
  category         String
  level            String?
  // Zielgruppe(n) nach Alter, für die Filterung im Kursangebot (z.B. Kurse für Kinder).
  ageGroups        AgeGroup[] @default([])
  // Preis pro Monat in Cent (z.B. 2900 = 29,00 €)
  priceCents       Int
  currency         String     @default("eur")
  // ID des Stripe Price-Objekts (recurring, monatlich) für den Checkout
  stripePriceId    String?
  isPublished      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  // Hoechstzahl der Teilnehmer (Personen, nicht Konten); null = unbegrenzt. Ist der Kurs voll,
  // erscheint er als ausgebucht und Interessenten tragen sich in die Warteliste ein.
  maxParticipants  Int?
  // Versteckter Kurs (z. B. Testphase): erscheint nicht im Kursangebot, Stundenplan und auf der
  // Lehrerseite, ist aber ueber den geheimen Link /zugang/<accessCode> erreichbar und buchbar.
  isHidden         Boolean    @default(false)
  accessCode       String?    @unique
  // Optionale einmalige Anmeldegebuehr (Stripe-Preis, nicht wiederkehrend), wird mit der ersten
  // Rechnung des Abos faellig. Betrag in Cent nur fuer die Anzeige.
  signupFeeCents   Int?
  signupFeePriceId String?
  // Laufzeit des Kurses (optional), z. B. 01.02. bis 30.06.
  startsOn         DateTime?  @db.Date
  endsOn           DateTime?  @db.Date

  teacherId String
  teacher   User   @relation("TeacherCourses", fields: [teacherId], references: [id])

  sessions       ClassSession[]
  enrollments    Enrollment[]
  scheduleSlots  ScheduleSlot[]
  waitlist       WaitlistEntry[]
  readingSamples ReadingSample[]
  invitations    Invitation[]
  trialLessons   TrialLesson[]
}

// Wiederkehrender wöchentlicher Termin eines Kurses (z.B. "Mittwoch 18:00-18:40"),
// unabhängig von den konkreten ClassSession-Terminen mit Zoom-Link. Dient der
// Anzeige im Kursangebot/Stundenplan und der Filterung nach Wochentag.
model ScheduleSlot {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  weekday   Weekday
  // Uhrzeit als "HH:MM", z.B. "18:00"
  startTime String
  endTime   String
  // Optionaler Hinweis, z.B. "Morgens"
  note      String?
}

// Eine wiederkehrende oder einmalige Unterrichtseinheit innerhalb eines Kurses.
model ClassSession {
  id                  String        @id @default(cuid())
  courseId            String
  course              Course        @relation(fields: [courseId], references: [id])
  title               String
  startsAt            DateTime
  durationMin         Int           @default(60)
  classroomType       ClassroomType @default(JITSI)
  // Bei JITSI/ZOOM: der Meeting-Link. Bei IN_APP (zukünftig): Referenz auf den eigenen Klassenraum.
  joinUrl             String?
  // Zoom-Meeting-ID, falls der Link automatisch ueber die Zoom-API erzeugt wurde.
  zoomMeetingId       String?
  createdAt           DateTime      @default(now())
  // Zeitpunkt, zu dem die jeweilige Erinnerungs-E-Mail verschickt wurde (verhindert
  // doppelten Versand bei jedem Cron-Durchlauf).
  reminder24hSentAt   DateTime?
  reminder1hSentAt    DateTime?
  reminderStartSentAt DateTime?
  // Notiz der Lehrkraft fuer alle Teilnehmer: was in der Stunde durchgenommen wurde und die
  // Hausaufgabe bis zur naechsten Stunde.
  lessonContent       String?
  homework            String?
  // Bitte der Lehrkraft um eine Leseprobe vor dieser Stunde, z. B. "Sure 67, Verse 1-10".
  // Steht im Dashboard und in der Erinnerung 24 Stunden vorher.
  readingRequest      String?

  evaluations    SessionEvaluation[]
  readingSamples ReadingSample[]
}

enum AttendanceStatus {
  PRESENT
  EXCUSED
  ABSENT
}

// Auswertung einer Stunde pro Teilnehmer: Anwesenheit und Lernfortschritt. Sichtbar fuer die
// Lehrkraft, den Admin und den Konto-Inhaber des Teilnehmers (nicht fuer andere Teilnehmer).
model SessionEvaluation {
  id            String            @id @default(cuid())
  sessionId     String
  session       ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  attendance    AttendanceStatus?
  // Stand nach der Stunde: bis zu welcher Sure (1-114) und welchem Vers gelesen bzw. gelernt wurde.
  surah         Int?
  ayah          Int?
  // Einschaetzung der Tadschwid-Regeln von 1 (viel Uebung noetig) bis 5 (sehr sicher).
  tajweedRating Int?
  // Persoenliche Rueckmeldung der Lehrkraft.
  comment       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([sessionId, participantId])
  @@index([participantId])
}

// Person, die an Kursen teilnimmt. Ein Konto (User) kann mehrere Teilnehmer anlegen: sich
// selbst, Kinder und andere Erwachsene. Der Konto-Inhaber bucht und bezahlt, muss aber nicht
// selbst teilnehmen.
model Participant {
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  // Optionaler muslimischer Name, siehe User.muslimName. Bei SELF folgt er dem Konto.
  muslimName         String?
  relation           ParticipantRelation
  // Nur bei Kindern: Geburtsjahr zur Alterspruefung (bewusst kein volles Geburtsdatum).
  birthYear          Int?
  // Kontakt-E-Mail der Person. Pflicht bei SELF/OTHER (Zugangslinks), bei Kindern optional;
  // ohne eigene Adresse gehen Mails an den Konto-Inhaber.
  email              String?
  // Optionale WhatsApp-Nummer (bei Kindern: Nummer der Eltern) und Einwilligung, dass sie an
  // die Lehrkraft weitergegeben und in die Kurs-Gruppe aufgenommen wird.
  whatsapp           String?
  whatsappConsentAt  DateTime?
  // Nachweis: Erziehungsberechtigung (CHILD) bzw. Erwachsenen-Bestaetigung und Einverstaendnis
  // der Person (OTHER).
  consentConfirmedAt DateTime?
  createdAt          DateTime            @default(now())

  enrollments    Enrollment[]
  evaluations    SessionEvaluation[]
  readingSamples ReadingSample[]

  @@index([ownerId])
}

// Interessent auf der Warteliste eines vollen Kurses (ohne Konto, ohne Zahlung). Die Reihenfolge
// ergibt sich aus createdAt (wer sich zuerst einträgt, steht oben).
model WaitlistEntry {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  email       String
  // Einwilligung in die Speicherung der Angaben zur Benachrichtigung.
  consentAt   DateTime
  createdAt   DateTime  @default(now())
  // Wann die Lehrkraft zuletzt angefragt hat, ob das Interesse weiter besteht.
  contactedAt DateTime?

  @@unique([courseId, email])
  @@index([courseId, createdAt])
}

model Enrollment {
  id              String        @id @default(cuid())
  // Konto-Inhaber (zahlt das Abo); der Teilnehmer steht in participantId.
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  participantId   String
  participant     Participant   @relation(fields: [participantId], references: [id])
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id])
  // Abo, ueber das die Teilnahme bezahlt wird (ein Abo kann mehrere Teilnehmer abdecken).
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  // Von der Lehrkraft markiert: in die WhatsApp-Gruppe des Kurses aufgenommen.
  whatsappAddedAt DateTime?

  @@unique([participantId, courseId])
}

// Ein einzelner Datensatz (id fest "main") für global editierbare Website-Texte,
// z.B. das Statement of Purpose. Admin-editierbar, ohne dass dafür Code-Änderungen
// nötig sind.
model SiteContent {
  id                 String    @id @default("main")
  missionStatement   String    @default("")
  // Rechtstexte, im Admin-Bereich pflegbar. Leer = es wird der Standardtext aus
  // src/lib/legal-defaults.ts angezeigt.
  impressum          String    @default("")
  privacyPolicy      String    @default("")
  // Letzter Aufruf des Erinnerungs-Endpoints (Ueberwachung des externen Cron-Dienstes).
  remindersLastRunAt DateTime?
  updatedAt          DateTime  @updatedAt
}

// Spiegelt das Stripe-Abo pro Nutzer & Kurs, damit Zugriff (Enrollment)
// unabhängig von Stripe-Ausfällen anhand lokaler Daten geprüft werden kann.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  courseId             String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  // Anzahl der Teilnehmer, die dieses Abo bezahlt (Stripe-Menge der Position).
  quantity             Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  enrollments Enrollment[]
}

// Einmal-Link zum Zuruecksetzen des Passworts. Gespeichert wird nur der Hash des Tokens,
// der Klartext steht ausschliesslich im E-Mail-Link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Datei der Mediathek (Lehrmaterial wie PDFs). Mit Vercel Blob (BLOB_READ_WRITE_TOKEN gesetzt)
// liegt die Datei im Blob-Speicher (blobPathname), sonst als Bytes in der Datenbank (nur bis
// ca. 4 MB, siehe src/lib/media.ts). Listen laden "data" nie mit.
model MediaFile {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Angezeigter Name, z. B. "Arbeitsblatt Sure Al-Fatiha"
  title        String
  // Dateiname fuer Download und E-Mail-Anhang, z. B. "arbeitsblatt.pdf"
  fileName     String
  mimeType     String
  sizeBytes    Int
  data         Bytes?
  // Vercel Blob: Pfad der Datei im Speicher und deren Adresse
  blobPathname String?
  blobUrl      String?
  createdAt    DateTime @default(now())

  @@index([ownerId, createdAt])
}

// Kurze Audioaufnahme eines Teilnehmers (Leseprobe), die sich die Lehrkraft vor der Stunde
// anhoert. Nur fuer Konto-Inhaber, Lehrkraft des Kurses und Admin abrufbar; wird nach
// READING_SAMPLE_RETENTION_DAYS (src/lib/reading-samples.ts) automatisch geloescht.
// Speicherung wie in der Mediathek: Vercel Blob (blobPathname) oder als Bytes in der Datenbank.
model ReadingSample {
  id             String        @id @default(cuid())
  participantId  String
  participant    Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Stunde, fuer die die Leseprobe gedacht ist (optional).
  sessionId      String?
  session        ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  mimeType       String
  sizeBytes      Int
  durationSec    Int?
  data           Bytes?
  blobPathname   String?
  // Kurzer Hinweis des Teilnehmers, z. B. "Verse 1-10, beim Idgham unsicher"
  note           String?
  // Rueckmeldung der Lehrkraft
  listenedAt     DateTime?
  teacherComment String?
  createdAt      DateTime      @default(now())

  @@index([courseId, createdAt])
  @@index([participantId])
  @@index([sessionId])
}

// Im Admin-Bereich angepasste Texte der automatischen E-Mails (Schluessel siehe
// src/lib/email-defaults.ts). Fehlt der Eintrag, gilt der Standardtext aus dem Code.
model EmailTemplate {
  key         String   @id
  subject     String
  body        String
  buttonLabel String   @default("")
  footer      String   @default("")
  updatedAt   DateTime @updatedAt
}

// Einladung eines Schuelers zu einem Kurs, per E-Mail oder als Link (z. B. per WhatsApp).
// Gespeichert wird nur der Hash des Tokens. Normalerweise fuehrt der Link zur normalen
// Anmeldung mit Bezahlung; mit freeEnrollment (nur Admins) wird ohne Zahlung eingetragen.
model Invitation {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Nur fuer die Anzeige und die Mail; bei Link-Einladungen optional.
  name           String?
  email          String?
  freeEnrollment Boolean   @default(false)
  invitedById    String
  invitedBy      User      @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  // Ohne Zahlung: einmal nutzbar, danach gesetzt.
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([courseId])
}

// Ereignisse fuer Lehrkraefte und Admins (Feed unter /teacher/benachrichtigungen bzw.
// /admin/benachrichtigungen). Wer welches Ereignis bekommt, steht in src/lib/notifications.ts.
enum NotificationType {
  ENROLLMENT_CREATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_ENDED
  PAYMENT_FAILED
  READING_SAMPLE_UPLOADED
  WAITLIST_JOINED
}

// Ein Ereignis (z. B. "neuer Teilnehmer angemeldet"). Kein Fremdschluessel auf Kurs oder
// Teilnehmer, damit der Verlauf beim Loeschen erhalten bleibt; die Namen stehen in "data".
// dedupeKey verhindert doppelte Eintraege, weil Stripe Ereignisse mehrfach schickt.
model ActivityEvent {
  id            String           @id @default(cuid())
  type          NotificationType
  courseId      String?
  participantId String?
  data          Json             @default("{}")
  dedupeKey     String           @unique
  createdAt     DateTime         @default(now())

  notifications Notification[]

  @@index([createdAt])
  @@index([courseId])
}

// Ein Ereignis fuer eine empfangende Person (Lehrkraft oder Admin).
model Notification {
  id        String        @id @default(cuid())
  eventId   String
  event     ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([userId, readAt])
}

// E-Mail an/aus pro Nutzer und Ereignistyp. Fehlt der Eintrag, gilt der Standard aus dem Code.
model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  email  Boolean

  @@unique([userId, type])
}

// Kostenlose Probestunde zu einem Kurs: Lehrkraft oder Admin laedt eine oder mehrere Personen
// (ohne Konto) zu einem gemeinsamen Termin ein. Die Gaeste bekommen den Link zum
// Unterrichtsraum per E-Mail (mit Kalendereintrag) und Erinnerungen vorher.
model TrialLesson {
  id                String        @id @default(cuid())
  courseId          String
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  durationMin       Int           @default(30)
  classroomType     ClassroomType @default(JITSI)
  joinUrl           String
  zoomMeetingId     String?
  // Wer eingeladen hat (Lehrkraft oder Admin).
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  canceledAt        DateTime?
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?

  guests TrialGuest[]

  @@index([startsAt])
  @@index([courseId])
}

model TrialGuest {
  id            String      @id @default(cuid())
  trialLessonId String
  trialLesson   TrialLesson @relation(fields: [trialLessonId], references: [id], onDelete: Cascade)
  name          String
  email         String
  // Erbetene Hoerprobe, z. B. "Sure 67 Al-Mulk, Verse 1–10"; leer = keine erbeten.
  sampleRequest String?
  // Der persoenliche Link zum Aufnehmen (ohne Konto) wird aus der ID abgeleitet, siehe
  // src/lib/trial-samples.ts.
  createdAt     DateTime    @default(now())

  samples TrialSample[]

  @@index([trialLessonId])
}

// Hoerprobe eines Probestunden-Gastes (ohne Konto, ueber den persoenlichen Link). Meldet sich
// der Gast spaeter mit derselben E-Mail-Adresse zum Kurs an, wird sie als ReadingSample
// seinem Teilnehmer zugeordnet und hier geloescht.
model TrialSample {
  id           String     @id @default(cuid())
  trialGuestId String
  trialGuest   TrialGuest @relation(fields: [trialGuestId], references: [id], onDelete: Cascade)
  mimeType     String
  sizeBytes    Int
  durationSec  Int?
  data         Bytes?
  blobPathname String?
  note         String?
  // Bestaetigung Datenschutzhinweis und Volljaehrigkeit (bzw. Erziehungsberechtigung) beim Hochladen
  consentAt    DateTime
  listenedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([trialGuestId])
}
