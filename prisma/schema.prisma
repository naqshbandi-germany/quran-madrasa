generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// Wie eine Kurssitzung wahrgenommen wird. JITSI ist der Standard (Link wird
// automatisch generiert); ZOOM bleibt als manuelle Override-Option bestehen.
// IN_APP ist als Erweiterungspunkt für einen späteren eigenen Klassenraum
// (Video + Tafel, z.B. selbst gehostetes Jitsi) vorgesehen, ohne dass sich das
// Datenmodell ändern muss.
enum ClassroomType {
  JITSI
  ZOOM
  IN_APP
}

// Zielgruppe eines Kurses nach Alter. Ein Kurs kann mehrere Altersgruppen ansprechen
// (z.B. "für alle Altersgruppen"), daher als Array am Kurs statt als Einzelwert.
enum AgeGroup {
  KIDS // 6-13 Jahre
  TEENS // 14-22 Jahre
  ADULTS // 23+ Jahre
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  // Foto-URL fürs Lehrer-Profil (kein eigener Datei-Upload, nur ein Link auf ein
  // gehostetes Bild).
  image         String?
  // Kurze Vita fürs Lehrer-Profil, nur für Rolle TEACHER relevant.
  bio           String?
  // E-Mail-Adresse des Zoom-Kontos, unter dem dieser Lehrer Meetings leitet (nur
  // relevant bei CLASSROOM_PROVIDER=zoom; sonst gilt ZOOM_HOST_EMAIL).
  zoomEmail     String?
  createdAt     DateTime  @default(now())

  stripeCustomerId String? @unique

  taughtCourses Course[]       @relation("TeacherCourses")
  enrollments   Enrollment[]
  subscriptions Subscription[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  // Kategorie, z.B. "Koran-Rezitation (Tadschwid)", "Hifz", "Arabisch", "Islamische Wissenschaften"
  category    String
  level       String?
  // Zielgruppe(n) nach Alter, für die Filterung im Kursangebot (z.B. Kurse für Kinder).
  ageGroups   AgeGroup[] @default([])
  // Preis pro Monat in Cent (z.B. 2900 = 29,00 €)
  priceCents  Int
  currency    String   @default("eur")
  // ID des Stripe Price-Objekts (recurring, monatlich) für den Checkout
  stripePriceId String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  teacherId   String
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])

  sessions      ClassSession[]
  enrollments   Enrollment[]
  scheduleSlots ScheduleSlot[]
}

// Wiederkehrender wöchentlicher Termin eines Kurses (z.B. "Mittwoch 18:00-18:40"),
// unabhängig von den konkreten ClassSession-Terminen mit Zoom-Link. Dient der
// Anzeige im Kursangebot/Stundenplan und der Filterung nach Wochentag.
model ScheduleSlot {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  weekday   Weekday
  // Uhrzeit als "HH:MM", z.B. "18:00"
  startTime String
  endTime   String
  // Optionaler Hinweis, z.B. "Morgens"
  note      String?
}

// Eine wiederkehrende oder einmalige Unterrichtseinheit innerhalb eines Kurses.
model ClassSession {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id])
  title         String
  startsAt      DateTime
  durationMin   Int           @default(60)
  classroomType ClassroomType @default(JITSI)
  // Bei JITSI/ZOOM: der Meeting-Link. Bei IN_APP (zukünftig): Referenz auf den eigenen Klassenraum.
  joinUrl        String?
  // Zoom-Meeting-ID, falls der Link automatisch ueber die Zoom-API erzeugt wurde.
  zoomMeetingId  String?
  createdAt      DateTime     @default(now())
  // Zeitpunkt, zu dem die jeweilige Erinnerungs-E-Mail verschickt wurde (verhindert
  // doppelten Versand bei jedem Cron-Durchlauf).
  reminder24hSentAt   DateTime?
  reminder1hSentAt    DateTime?
  reminderStartSentAt DateTime?
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// Ein einzelner Datensatz (id fest "main") für global editierbare Website-Texte,
// z.B. das Statement of Purpose. Admin-editierbar, ohne dass dafür Code-Änderungen
// nötig sind.
model SiteContent {
  id               String   @id @default("main")
  missionStatement String   @default("")
  // Rechtstexte, im Admin-Bereich pflegbar. Leer = es wird der Standardtext aus
  // src/lib/legal-defaults.ts angezeigt.
  impressum        String   @default("")
  privacyPolicy    String   @default("")
  updatedAt        DateTime @updatedAt
}

// Spiegelt das Stripe-Abo pro Nutzer & Kurs, damit Zugriff (Enrollment)
// unabhängig von Stripe-Ausfällen anhand lokaler Daten geprüft werden kann.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  courseId             String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
