# Datenbank (lokal z.B. via Docker Postgres, siehe README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quran_madrasa"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="mit `openssl rand -base64 32` generieren"

# Stripe (Testmodus-Keys aus dem Stripe-Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Basis-URL der App (für Stripe Success/Cancel-Redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Link zur kostenlosen Erstberatung (Cal.com o.ä.). Ohne diese Variable wird der
# Button auf der Seite automatisch ausgeblendet.
NEXT_PUBLIC_BOOKING_URL="https://cal.com/euer-team/erstberatung"
