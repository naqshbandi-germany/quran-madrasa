# Datenbank (lokal z.B. via Docker Postgres, siehe README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quran_madrasa"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="mit `openssl rand -base64 32` generieren"

# Stripe (Testmodus-Keys aus dem Stripe-Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Basis-URL der App (für Stripe Success/Cancel-Redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Link zur kostenlosen Erstberatung (Cal.com o.ä.). Ohne diese Variable wird der
# Button auf der Seite automatisch ausgeblendet.
NEXT_PUBLIC_BOOKING_URL="https://cal.com/euer-team/erstberatung"

# Resend (E-Mail-Erinnerungen vor Kursbeginn)
RESEND_API_KEY="re_..."
# Muss zu einer bei Resend verifizierten Domain gehören, siehe README.
RESEND_FROM_EMAIL="Quran Madrasa <meeting@islamunterfreunden.de>"
# Separater Absender fuer Kursmaterial-Mails vom Lehrer an die Kursteilnehmer.
# Optional - faellt ohne diese Variable auf RESEND_FROM_EMAIL zurueck.
RESEND_MATERIAL_FROM_EMAIL="Quran Madrasa <material@islamunterfreunden.de>"

# Geheimnis, mit dem sich der GitHub-Actions-Workflow
# (.github/workflows/send-reminders.yml) beim Cron-Endpoint authentifiziert.
# Mit `openssl rand -base64 32` generieren.
CRON_SECRET="..."

# Videokonferenz fuer NEUE Sitzungen: "jitsi" (Standard, kostenlos) oder "zoom".
# Bereits angelegte Sitzungen behalten ihren Link. Einrichtung: README, Abschnitt Videokonferenz.
CLASSROOM_PROVIDER="jitsi"
# Nur bei "zoom": Zugangsdaten der Server-to-Server-OAuth-App aus dem Zoom Marketplace.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Zoom-Konto (E-Mail), unter dem Meetings angelegt werden, wenn beim Lehrer keins hinterlegt ist.
ZOOM_HOST_EMAIL=""
